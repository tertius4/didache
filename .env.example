# Copy to .env and fill in. Leaving a value empty disables that feature.

# PostHog project API key (anonymous, cookieless analytics)
VITE_POSTHOG_KEY=
# Defaults to https://eu.i.posthog.com
VITE_POSTHOG_HOST=

# Formspree form id (the part after https://formspree.io/f/) for waitlist + feedback
VITE_FORMSPREE_ID=
