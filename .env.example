# Copy to .env and fill in. Leaving a value empty disables that feature.

# PostHog public project token
VITE_POSTHOG_KEY=your_posthog_project_token_here
# PostHog ingestion host
VITE_POSTHOG_HOST=https://your-posthog-host.example

# Formspree form id (the part after https://formspree.io/f/) for waitlist + feedback
VITE_FORMSPREE_ID=xxx

# Public site origin, used for canonical and Open Graph URLs (baked in at build time)
VITE_SITE_URL=https://didache.co.za
